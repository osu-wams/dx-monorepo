{
  "name": "root",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "CI=true FORCE_COLOR=true lerna run build",
    "typecheck": "FORCE_COLOR=true lerna run typecheck",
    "test": "CI=true FORCE_COLOR=true lerna run test -- --coverage",
    "lint": "FORCE_COLOR=true eslint packages",
    "format": "prettier --write \"packages/*/{src,test}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/{src,test}/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "publish:dev": "FORCE_COLOR=true lerna publish prerelease --no-git-tag-version --no-push",
    "publish:patch": "FORCE_COLOR=true lerna publish patch",
    "publish:prerelease": "FORCE_COLOR=true lerna publish prerelease --force-publish",
    "COMMMENT_publish:local": "package-list-build-order causes yalc to build packages in the order of which they are dependent upon eachother",
    "publish:local": "cat package-list-build-order | xargs -n1 -I {} bash -c '{ cd \"packages/{}\" && yalc publish --update && cd .. cd .. ;}'"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lerna": "^10.1.1",
    "prettier": "^3.9.10",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-test-renderer": "^17.0.2",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "resolutions": {
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "**/nx/undici": "^7.30.1"
  }
}
